              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Sale"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Sale"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sale"
