              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedExportRowList"
                }
              }
            },
            "description": ""
          },
          "403": {
            "description": "Only accountants and administrators"
          }
        },
        "security": [
          {
            "cookieAuth": []
          },
          {
            "basicAuth": []
          },
          {}
        ],
        "tags": [
          "api"
        ]
      }
    },
    "/api/v1/sales/{id}/": {
      "delete": {
        "operationId": "api_v1_sales_destroy",
        "parameters": [
          {
            "description": "A unique integer value identifying this sale.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No response body"
