{
  "components": {
    "schemas": {
      "ExportRow": {
        "properties": {
          "student": {
            "type": "string"
          },
          "total": {
            "format": "decimal",
            "pattern": "^-?\\d{0,10}(?:\\.\\d{0,2})?$",
            "type": "string"
          }
        },
        "required": [
          "student",
          "total"
        ],
        "type": "object"
      },
      "PaginatedExportRowList": {
        "properties": {
          "count": {
            "example": 123,
            "type": "integer"
          },
          "next": {
            "example": "http://api.example.org/accounts/?page=4",
            "format": "uri",
            "nullable": true,
            "type": "string"
          },
          "previous": {
            "example": "http://api.example.org/accounts/?page=2",
            "format": "uri",
            "nullable": true,
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/ExportRow"
            },
            "type": "array"
          }
        },
        "required": [
          "count",
          "results"
        ],
        "type": "object"
      },
      "PaginatedSaleList": {
        "properties": {
          "count": {
            "example": 123,
            "type": "integer"
          },
          "next": {
            "example": "http://api.example.org/accounts/?page=4",
            "format": "uri",
            "nullable": true,
            "type": "string"
          },
          "previous": {
            "example": "http://api.example.org/accounts/?page=2",
            "format": "uri",
            "nullable": true,
            "type": "string"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/Sale"
            },
            "type": "array"
          }
        },
        "required": [
          "count",
          "results"
        ],
        "type": "object"
      },
      "PatchedSale": {
        "properties": {
          "currency": {
            "maxLength": 3,
            "type": "string"
          },
          "id": {
            "readOnly": true,
            "type": "integer"
          },
          "quantity": {
            "format": "int64",
            "maximum": 9223372036854776000,
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/StatusEnum"
          },
          "student": {
            "maxLength": 100,
            "type": "string"
          },
          "total": {
            "format": "decimal",
            "pattern": "^-?\\d{0,10}(?:\\.\\d{0,2})?$",
            "readOnly": true,
            "type": "string"
          },
          "unit_price": {
            "format": "decimal",
            "pattern": "^-?\\d{0,8}(?:\\.\\d{0,2})?$",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Sale": {
        "properties": {
          "currency": {
            "maxLength": 3,
            "type": "string"
          },
          "id": {
            "readOnly": true,
            "type": "integer"
          },
          "quantity": {
            "format": "int64",
            "maximum": 9223372036854776000,
            "minimum": 0,
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/StatusEnum"
          },
          "student": {
            "maxLength": 100,
            "type": "string"
          },
          "total": {
            "format": "decimal",
            "pattern": "^-?\\d{0,10}(?:\\.\\d{0,2})?$",
            "readOnly": true,
            "type": "string"
          },
          "unit_price": {
            "format": "decimal",
            "pattern": "^-?\\d{0,8}(?:\\.\\d{0,2})?$",
            "type": "string"
          }
        },
        "required": [
          "currency",
          "id",
          "student",
          "total",
          "unit_price"
        ],
        "type": "object"
      },
      "StatusEnum": {
        "description": "* `draft` - draft\n* `paid` - paid",
        "enum": [
          "draft",
          "paid"
        ],
        "type": "string"
      }
    },
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      },
      "cookieAuth": {
        "in": "cookie",
        "name": "sessionid",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "School API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/v1/sales/": {
      "get": {
        "operationId": "api_v1_sales_list",
        "parameters": [
          {
            "description": "A page number within the paginated result set.",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedSaleList"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "cookieAuth": []
          },
          {
            "basicAuth": []
          },
          {}
        ],
        "tags": [
          "api"
        ]
      },
