{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/openspec/tooling/hooks/session-start.mjs\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/openspec/tooling/hooks/answers-gate.mjs\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/openspec/tooling/hooks/archive-gate.mjs\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/openspec/tooling/hooks/boundary-guard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/openspec/tooling/hooks/schema-starter.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/openspec/tooling/hooks/test-cases-run-limit.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/openspec/tooling/hooks/artifact-feedback.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(node openspec/tooling/bin/e2e-run.mjs *)",
      "Bash(node openspec/tooling/bin/review-input.mjs *)",
      "Bash(node openspec/tooling/bin/start-check.mjs *)",
      "Bash(node openspec/tooling/checks/check-answers.mjs *)",
      "Bash(node openspec/tooling/checks/check-apply-report.mjs *)",
      "Bash(node openspec/tooling/checks/check-e2e.mjs *)",
      "Bash(node openspec/tooling/checks/check-grounding.mjs *)",
      "Bash(node openspec/tooling/checks/check-specs.mjs *)",
      "Bash(node openspec/tooling/checks/check-test-cases.mjs *)",
      "Bash(node openspec/tooling/checks/check-traceability.mjs *)",
      "Bash(node openspec/tooling/checks/check-ui.mjs *)",
      "Bash(node openspec/tooling/checks/lint-kit.mjs *)",
      "Bash(sha256sum openspec/changes/*)",
      "Bash(shasum -a 256 openspec/changes/*)"
    ]
  }
}
